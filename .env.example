# Vinyl Radar — 로컬 개발 환경 변수
# 사용법: cp .env.example .env  (.env 는 커밋하지 않습니다)

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=vinyl
POSTGRES_PASSWORD=vinyl_local_dev_only
POSTGRES_DB=vinyl_radar
# 호스트에 노출할 포트. 로컬에 다른 postgres 가 떠 있으면 5433 등으로 변경
POSTGRES_HOST_PORT=5432

# 컨테이너 내부에서 사용하는 접속 문자열 (호스트명은 compose 서비스명 'postgres')
DATABASE_URL=postgresql+asyncpg://vinyl:vinyl_local_dev_only@postgres:5432/vinyl_radar

# ─── API ───────────────────────────────────────────────────────
API_HOST_PORT=8000
ENVIRONMENT=local
LOG_LEVEL=INFO
# 컨테이너 마운트에서 inotify 가 동작하지 않아 --reload 가 먹지 않는 문제 대응.
# CPU 를 조금 더 쓰므로, 핫 리로드가 필요 없으면 false 로 두어도 됩니다.
WATCHFILES_FORCE_POLLING=true

# ─── 웹 ─────────────────────────────────────────────────────────
WEB_HOST_PORT=3000
# 구독 화면(.ics / .rss)에 표시할 공개 API 주소. 배포 시 실제 도메인으로 교체할 것.
PUBLIC_API_URL=http://localhost:8000

# ─── 운영자 API (ADR-0005) ──────────────────────────────────────
# 발매 일정을 등록하는 관리 엔드포인트의 유일한 인증 수단.
# 계정 시스템을 쓰지 않으므로 이 키가 새면 누구나 일정을 등록할 수 있다.
# 실제 운영 시 반드시 교체할 것: openssl rand -hex 32
# openssl rand -base64 32 로 생성할 것. 기본값을 그대로 쓰면 기동이 실패한다.
ADMIN_API_KEY=change-me-local-dev-only

# ─── 수집기 (M3 까지 잠들어 있음) ────────────────────────────────
# 블루프린트 §3.4: 크롤러는 정체와 연락처를 반드시 밝힌다.
# 실제 도메인·연락처가 정해지면 교체할 것.
CRAWLER_USER_AGENT=VinylRadar/1.0 (+https://example.com/about; contact@example.com)
# 소스별 최대 요청 속도(req/s). 블루프린트 §3.4 상한 0.5 를 넘기지 말 것.
CRAWLER_RATE_LIMIT_RPS=0.5
CRAWLER_MAX_CONCURRENCY=2

# ─── Web Push (VAPID, ADR-0006) ─────────────────────────────────
# 자체 생성 키 쌍이라 외부 계정도 비용도 없다. 아래로 생성:
#   python -c "import base64;from cryptography.hazmat.primitives import serialization as s;\
#   from cryptography.hazmat.primitives.asymmetric import ec;k=ec.generate_private_key(ec.SECP256R1());\
#   b=lambda r:base64.urlsafe_b64encode(r).decode().rstrip('=');\
#   print('VAPID_PUBLIC_KEY='+b(k.public_key().public_bytes(s.Encoding.X962,s.PublicFormat.UncompressedPoint)));\
#   print('VAPID_PRIVATE_KEY='+b(k.private_numbers().private_value.to_bytes(32,'big')))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 발생 시 연락할 주소. **요청에 함께 전송된다.**
VAPID_SUBJECT=mailto:you@example.com
# 알림을 눌렀을 때 이동할 주소. 실제 기기에서 시험할 때는
# 터널/HTTPS 주소로 바꿔야 링크가 살아 있다.
PUBLIC_WEB_URL=http://localhost:3000
