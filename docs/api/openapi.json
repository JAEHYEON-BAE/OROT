    "/healthz": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Healthz",
        "description": "헬스체크. 블루프린트 §5.2 에 따라 **DB 연결까지 확인**한다.\n\nDB 가 응답하지 않으면 503 을 반환한다. 배포 검증(§9.5)이 이 응답에 의존하므로\nDB 장애를 200 으로 감추지 않는다.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
